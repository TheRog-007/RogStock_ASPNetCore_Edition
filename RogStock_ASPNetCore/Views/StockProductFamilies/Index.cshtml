@model IEnumerable<RogStock_ASPNetCore.Models_RogStock.StockProductFamily>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StkpProductFamily)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StkpDesc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Timestamp)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.StkpProductFamily)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StkpDesc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Timestamp)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StkpId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.StkpId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.StkpId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

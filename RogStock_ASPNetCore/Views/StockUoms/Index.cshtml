@model IEnumerable<RogStock_ASPNetCore.Models_RogStock.StockUom>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StkuDesc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Timestamp)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.StkuDesc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Timestamp)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StkuId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.StkuId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.StkuId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

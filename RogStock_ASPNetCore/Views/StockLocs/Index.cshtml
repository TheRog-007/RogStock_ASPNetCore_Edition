@model IEnumerable<RogStock_ASPNetCore.Models_RogStock.StockLoc>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LocItemId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LocLocation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LocUpdated)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LocQty)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LocNonNet)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LocDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Timestamp)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LocItemId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LocLocation)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LocUpdated)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LocQty)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LocNonNet)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LocDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Timestamp)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.LocId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.LocId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.LocId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

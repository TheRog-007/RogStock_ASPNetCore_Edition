@model RogStock_ASPNetCore.Models_RogStock.StockLoc

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>StockLoc</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="LocItemId" class="control-label"></label>
                <input asp-for="LocItemId" class="form-control" />
                <span asp-validation-for="LocItemId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LocLocation" class="control-label"></label>
                <input asp-for="LocLocation" class="form-control" />
                <span asp-validation-for="LocLocation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LocQty" class="control-label"></label>
                <input asp-for="LocQty" class="form-control" />
                <span asp-validation-for="LocQty" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="LocNonNet" /> @Html.DisplayNameFor(model => model.LocNonNet)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="LocDescription" class="control-label"></label>
                <input asp-for="LocDescription" class="form-control" />
                <span asp-validation-for="LocDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

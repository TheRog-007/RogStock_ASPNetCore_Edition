    function OnChangeStockItem() {
        alert(cmbChosenStockItem.value);

        

        //store chosen stock item
        var param = cmbChosenStockItem.value;

        //if user has select: Please Select - exit!
        if (param == "Please Select")
        {
            return;
        }

        //below code adapted from internet example 28/01/2026
        //construct URL to pass data back to controller action
        var url = '@Url.Action("StockItemSelected", "AdjustQuantity", new { strItemID = "__param__" })';

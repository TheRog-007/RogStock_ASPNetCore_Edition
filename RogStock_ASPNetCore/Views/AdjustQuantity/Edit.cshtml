                    strQtyID = intNum.ToString()+"txtQty";
                    strLoc = intNum.ToString() + "txtLoc";

                    @* <form asp-action="Edit"> *@
                        <table class="table table-hover table-responsive-sm display">
                            <tbody>
                                <tr>
                                    <td>
                                        <input value="@Html.DisplayFor(modelitem => item.Location)" />
                                    </td>
                                    <td>
                                        <input id=@strQtyID name=@strQtyID value="@Html.DisplayFor(modelItem => item.LocQty)" onchange="OnChangeQty(this)" />
                                    </td>
                                    // <td>
                                    //     <div class="form-group">
                                    //         <button asp-route-id="@item.Location" type="submit" name="action" id="@strLoc">Update</button>
                                    //     </div>
                                    // </td>
                                </tr>
                            </tbody>
                        </table>
                    @* </form> *@
                        intNum++;
                 }
            }
            @* <div class="form-group">
                <label asp-for="LocLocation" class="control-label"></label>
                <input asp-for="LocLocation" class="form-control" />
                <span asp-validation-for="LocLocation" class="text-danger"></span>
            </div>
            @* <div class="form-group">
                <label asp-for="LocQty" class="control-label"></label>
                <input asp-for="LocQty" class="form-control" />
                <span asp-validation-for="LocQty" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="LocNonNet" /> @Html.DisplayNameFor(model => model.LocNonNet)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="LocDescription" class="control-label"></label>
                <input asp-for="LocDescription" class="form-control" />
                <span asp-validation-for="LocDescription" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
